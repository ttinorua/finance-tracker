<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Used for the optional Claude AI features (chat, category suggestions, insights) and
         for the optional Enable Banking bank sync (Sydbank open-banking / PSD2). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- A first Enable Banking sync (or any sync after local data was wiped) can take far
         longer than Android's ~10 minute background execution limit for ordinary work — the
         sync worker promotes itself to a foreground service (with a visible "Syncing…"
         notification) for the duration of the sync so the system doesn't keep killing and
         restarting it mid-fetch. FOREGROUND_SERVICE_DATA_SYNC is required alongside the base
         permission on Android 14+ for this specific foreground service type. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The AI advisor's voice: Android 11+ only lets the app see the phone's text-to-speech
         engine and speech recognizer when they're declared here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".FinanceApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PersonalFinanceTracker">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PersonalFinanceTracker">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Enable Banking OAuth redirect: our GitHub Pages bridge page sends the browser
                 here after MitID login completes (see enablebanking-redirect/index.html). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="financetracker" android:host="enablebanking-callback" />
            </intent-filter>
            <!-- Microsoft sign-in redirect for the automatic backup to OneDrive. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="financetracker" android:host="onedrive-auth" />
            </intent-filter>
            <!-- "Back to Finance Tracker" on the page shown after the ChatGPT sign-in: just brings the
                 app to the front (Chrome only opens apps from a page through a link like this). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="financetracker" android:host="chatgpt-done" />
            </intent-filter>
            <!-- A receipt shared from a store app (Netto+, Coop, Lidl Plus, REMA 1000…), a
                 screenshot or a PDF: the AI reads it and files it with its bank transaction. -->
            <intent-filter android:label="Add receipt">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <!-- Where the camera saves a photo of a paper receipt (see ReceiptFiles). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.receipts"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/receipt_paths" />
        </provider>

        <!-- WorkManager's own SystemForegroundService (used by setForeground()) needs its
             foreground service type declared here on Android 14+ whenever a worker requests
             one — see EnableBankingSyncWorker, which promotes itself to a foreground service
             for the duration of a sync so a large first sync survives Android's background
             execution time limit instead of being killed and restarted mid-fetch. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />
    </application>

</manifest>
